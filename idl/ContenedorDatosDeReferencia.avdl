@namespace("Integracion.Esquemas.Contenedor.Referencias")
protocol DatoDeReferenciaProtocol {
  import idl "DatosDeReferencia.avdl";
  record TrazaContendor{
    string numero;
    string tipo; // deprecado
    string ciclo;
    string estado;
    timestamp_ms cuando;
    union { null, string } operador=null;
    union { null, string } comentario=null; 
    union { null, string } prefijo=null;
    union { null, TipoContenedor } tipoContenedor=null;
    union { null, Integracion.Esquemas.Referencias.DatosSucursal } sucursalAsociadaAlEvento=null;
  }

  record Bulto {
    string numeroDeBulto;
    union { null, string } operador=null;
    timestamp_ms cuando;
  }

  record Envio {
    string codigoDeEnvio;
    int cantidadDeBultos;
    int cantidadDeBultosLeidos;
    string totalizador;
    union { null, array<Bulto>} bultos=null;
  }

  record Viaje {
    string codigo;
    union { null, string } choferDni=null;
    union { null, string } patenteVehiculo=null;
  }
  record Contenedor {
    string numero;
    union { null, TipoContenedor } tipoContenedor=null;
    union { null, boolean } esMixto=null;
  }
  record TipoContenedor {
    string nombre;
    map<int> referenciasExternas;
  }
  record ReferenciaExterna {
    string referencia;
  }
  record Documento {
    string numeroDeReferencia;
  }

  record ElementoModificado {
    string codigo;
    string tipo;
  }
}
